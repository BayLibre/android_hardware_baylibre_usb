apex {
    name: "com.android.hardware.usb.generic",
    manifest: "manifest.json",
    file_contexts: "file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,

    binaries: ["android.hardware.usb-service.generic"],
    prebuilts: [
        "com.android.hardware.usb.generic.rc", // init .rc
        "android.hardware.usb-service.generic.xml",
        "android.hardware.usb.gadget-service.generic.xml",
    ],
}

// Replace the binary path from /vendor/bin to /apex/{name}/bin in the init .rc file
genrule {
    name: "com.android.hardware.usb.rc-gen.generic",
    srcs: [":android.hardware.usb-service.generic.rc"],
    out: ["com.android.hardware.usb.generic.rc"],
    cmd: "sed -E 's@/vendor/bin@/apex/com.android.hardware.usb.generic/bin@' $(in) > $(out)",
}

prebuilt_etc {
    name: "com.android.hardware.usb.generic.rc",
    src: ":com.android.hardware.usb.rc-gen.generic",
    installable: false,
}

