cc_binary {
    name: "android.hardware.usb-service.generic",
    relative_install_path: "hw",
    vintf_fragments: [
        "android.hardware.usb-service.generic.xml",
        "android.hardware.usb.gadget-service.generic.xml",
    ],
    vendor: true,
    srcs: [
        "service.cpp",
        "UsbGadget.cpp",
        "Usb.cpp",
    ],
    shared_libs: [
        "android.hardware.usb-V3-ndk",
	    "android.hardware.usb.gadget-V1-ndk",
        "libbinder_ndk",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
	    "android.frameworks.stats-V1-ndk",
    ],
    installable: false, // ships with apex
}

prebuilt_etc {
    name: "android.hardware.usb-service.generic.xml",
    src: "android.hardware.usb-service.generic.xml",
    sub_dir: "vintf",
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.usb.gadget-service.generic.xml",
    src: "android.hardware.usb.gadget-service.generic.xml",
    sub_dir: "vintf",
    installable: false,
}

filegroup {
    name: "android.hardware.usb-service.generic.rc",
    srcs: ["android.hardware.usb-service.generic.rc"],
}
